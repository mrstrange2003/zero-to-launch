# Copy to .env and adjust. Never commit .env.

PROJECT_NAME=Zero-to-Launch API
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
# Short-lived access token (JSON body, kept in browser memory).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Long-lived refresh token (HttpOnly cookie scoped to /api/auth).
REFRESH_TOKEN_EXPIRE_DAYS=7
# Secure cookies work on http://localhost in Chrome/Edge/Firefox. Set false only for Safari on
# plain-http localhost. Must be true in production.
COOKIE_SECURE=true

# ---- Database ----
# SQLite (default). Relative to backend/ locally and to /app inside Docker.
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL: uncomment `psycopg[binary]` in backend/requirements.txt, then use ONE of:
#   Docker (compose `db` service): DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
#   Local Postgres:                DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Extra allowed origins (comma-separated). Any http(s)://localhost:<port> is always allowed.
CORS_ORIGINS=

BACKEND_PORT=8000

# Frontend: URL the browser uses to reach the API, and the host port for the UI.
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
